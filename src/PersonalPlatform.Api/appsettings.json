{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "personal-platform",
    "Audience": "personal-platform-api",
    "AccessTokenMinutes": 5,
    "ActiveKeyId": "",
    "SigningKeys": []
  },
  "Sessions": {
    "RefreshTokenDays": 14,
    "SessionMaxDays": 30,
    "MaxActiveSessionsPerUser": 10,
    "RetentionDays": 30
  },
  "AccountEmails": {
    "PublicBaseUrl": "https://localhost:5001",
    "MinSecondsBetweenEmails": 60
  },
  "Email": {
    "Mode": "Smtp",
    "FromAddress": "no-reply@localhost",
    "FromName": "Personal Platform",
    "SmtpHost": "localhost",
    "SmtpPort": 587,
    "UseTls": true,
    "QueueCapacity": 1000
  },
  "Security": {
    "AllowedOrigins": [],
    "KnownProxies": [],
    "KnownNetworks": [],
    "EnableHsts": false,
    "ExposeOpenApi": false
  },
  "RateLimits": {
    "UserRequestsPerMinute": 300,
    "AnonymousRequestsPerMinute": 60,
    "AuthRequestsPerMinute": 10,
    "RefreshRequestsPerMinute": 30,
    "ExportsPerMinute": 5,
    "ReportRequestsPerMinute": 60
  },
  "Bootstrap": {
    "AdminEmails": []
  }
}
