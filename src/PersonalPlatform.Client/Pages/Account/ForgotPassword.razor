@page "/forgot-password"
@attribute [AllowAnonymous]
@layout AuthLayout
@using PersonalPlatform.Contracts.Auth
@inject ApiClient Api

<PageTitle>@L["Восстановление пароля", "Reset password"]</PageTitle>
<h1>@L["Восстановление пароля", "Reset password"]</h1>
@if (_sent)
{
    <p role="status">@L["Если аккаунт с этим адресом существует, мы отправили письмо со ссылкой.", "If an account with this address exists, we have sent an email with a link."]</p>
    <a class="button" href="login">@L["Ко входу", "Back to sign in"]</a>
}
else
{
    <form class="stack" @onsubmit="SendAsync">
        <label class="field">
            <span>Email</span>
            <input type="email" @bind="_email" required maxlength="254" autocomplete="email" />
        </label>
        <ErrorText Error="_error" />
        <button type="submit" class="button button-primary button-block" disabled="@_busy">@L["Отправить ссылку", "Send link"]</button>
    </form>
    <div class="auth-links"><a href="login">@L["Ко входу", "Back to sign in"]</a></div>
}

@code {
    private string _email = string.Empty;
    private bool _sent;
    private bool _busy;
    private ApiException? _error;

    private async Task SendAsync()
    {
        _busy = true;
        try
        {
            await Api.PostAsync<AcceptedResponse>("/api/v1/auth/forgot-password", new EmailRequest(_email.Trim()));
            _sent = true;
        }
        catch (ApiException ex) when (ex.Code is "rate_limited" or "validation_failed")
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }
}
