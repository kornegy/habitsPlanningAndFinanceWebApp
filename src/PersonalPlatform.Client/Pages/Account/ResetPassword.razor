@page "/reset-password"
@attribute [AllowAnonymous]
@layout AuthLayout
@using PersonalPlatform.Contracts.Auth
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>@L["Новый пароль", "New password"]</PageTitle>
<h1>@L["Новый пароль", "New password"]</h1>
@if (_done)
{
    <p>@L["Пароль изменён, все сеансы завершены. Войдите с новым паролем.", "Your password was changed and all sessions were signed out. Sign in with the new password."]</p>
    <a class="button button-primary" href="login">@L["Войти", "Sign in"]</a>
}
else if (_link is null)
{
    <p>@L["Ссылка недействительна или устарела.", "The link is invalid or has expired."]</p>
    <a class="button" href="forgot-password">@L["Запросить новую", "Request a new one"]</a>
}
else
{
    <form class="stack" @onsubmit="SubmitAsync">
        <label class="field">
            <span>@L["Новый пароль", "New password"]</span>
            <input type="password" @bind="_password" autocomplete="new-password" required minlength="@PasswordPolicy.MinLength" maxlength="@PasswordPolicy.MaxLength" />
        </label>
        <ErrorText Error="_error" />
        <button type="submit" class="button button-primary button-block" disabled="@_busy">@L["Сохранить", "Save"]</button>
    </form>
}

@code {
    private (Guid UserId, string Token)? _link;
    private string _password = string.Empty;
    private ApiException? _error;
    private bool _busy;
    private bool _done;

    protected override void OnInitialized()
    {
        _link = LinkFragment.Parse(Navigation.Uri);
        Navigation.NavigateTo("reset-password", replace: true); // remove the token from the address bar
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.PostAsync("/api/v1/auth/reset-password", new ResetPasswordRequest(_link!.Value.UserId, _link.Value.Token, _password));
            _password = string.Empty;
            _done = true;
        }
        catch (ApiException ex)
        {
            if (ex.Code == "invalid_token")
            {
                _link = null;
            }

            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }
}
