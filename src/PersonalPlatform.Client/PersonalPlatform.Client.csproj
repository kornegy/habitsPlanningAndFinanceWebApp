<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!--
    Blazor WebAssembly UI. Everything in this project is downloaded to the browser and must be treated as
    public and attacker-controlled: no secrets, no authorisation decisions, no authoritative calculations.
  -->
  <PropertyGroup>
    <RootNamespace>PersonalPlatform.Client</RootNamespace>
    <!--
      index.html references assets by their stable names (no build-time placeholder rewriting, no inline import
      map): the rewritten page is not carried into the publish output of the hosting API project, and without an
      inline script the CSP needs no hash. MapStaticAssets still serves fingerprinted framework files and
      revalidates the stable names with ETags.
    -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PersonalPlatform.Contracts\PersonalPlatform.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
</Project>
