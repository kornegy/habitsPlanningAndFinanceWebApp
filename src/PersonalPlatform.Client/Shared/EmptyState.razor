<div class="empty @(Compact ? "empty-compact" : null)">
    <span class="empty-icon" aria-hidden="true"><Icon Name="@IconName" Size="@(Compact ? 18 : 24)" /></span>
    <p class="empty-title">@Title</p>
    @if (Text is not null)
    {
        <p class="muted">@Text</p>
    }
    @ChildContent
</div>

@code {
    [Parameter] public string IconName { get; set; } = "dot";
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Small inline variant for dashboard widgets and side panels.</summary>
    [Parameter] public bool Compact { get; set; }
}
