@* User colour shown via an SVG attribute (allowed by the CSP, unlike inline style attributes). *@
<svg class="color-dot" width="@Size" height="@Size" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><circle cx="5" cy="5" r="5" fill="@SafeColor" /></svg>

@code {
    [Parameter] public string? Color { get; set; }
    [Parameter] public int Size { get; set; } = 10;

    // Only #RRGGBB values reach the attribute; the server validates the same format.
    private string SafeColor => Color is { Length: 7 } c && c[0] == '#' && c.Skip(1).All(Uri.IsHexDigit) ? c : "#8A8D86";
}
