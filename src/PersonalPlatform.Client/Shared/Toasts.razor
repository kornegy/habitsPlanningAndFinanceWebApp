@implements IDisposable
@inject ToastService ToastService
<div class="toasts" role="status" aria-live="polite">
    @foreach (var toast in ToastService.Items)
    {
        <div class="toast toast-@toast.Kind.ToString().ToLowerInvariant()" @key="toast.Id">
            <Icon Name="@(toast.Kind == ToastKind.Error ? "alert" : "check")" />
            <span>@toast.Message</span>
            <button type="button" class="icon-button" @onclick="() => ToastService.Dismiss(toast.Id)" aria-label="@L["Закрыть", "Dismiss"]"><Icon Name="x" Size="14" /></button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => ToastService.Changed += Refresh;

    public void Dispose() => ToastService.Changed -= Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);
}
