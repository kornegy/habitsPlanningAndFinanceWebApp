@* Accessible dialog: role=dialog + aria-modal, labelled by its title, Escape closes, focus moves inside on open
   and back to the page on close. Rendered only while open. *@
@if (Open)
{
    <div class="modal-backdrop" @onclick="Close"></div>
    <div class="modal @(Wide ? "modal-wide" : null)" role="dialog" aria-modal="true" aria-labelledby="@_titleId" tabindex="-1"
         @ref="_dialog" @onkeydown="OnKeyDown">
        <header class="modal-header">
            <h2 id="@_titleId">@Title</h2>
            <button type="button" class="icon-button" @onclick="Close" aria-label="@L["Закрыть", "Close"]"><Icon Name="x" /></button>
        </header>
        <div class="modal-body">@ChildContent</div>
        @if (Footer is not null)
        {
            <footer class="modal-footer">@Footer</footer>
        }
    </div>
}

@code {
    private readonly string _titleId = $"dlg-{Guid.NewGuid():N}";
    private ElementReference _dialog;
    private bool _focusPending;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public bool Wide { get; set; }

    protected override void OnParametersSet() => _focusPending = Open;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending && Open)
        {
            _focusPending = false;
            await _dialog.FocusAsync();
        }
    }

    private async Task Close() => await OpenChanged.InvokeAsync(false);

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Close();
        }
    }
}
