root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,targets,csproj,slnx,xml,razor,html,css,js}]
indent_size = 2

[*.razor]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Style
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Naming: private fields _camelCase
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

dotnet_naming_rule.const_pascal.severity = warning
dotnet_naming_rule.const_pascal.symbols = const_fields
dotnet_naming_rule.const_pascal.style = pascal
dotnet_naming_symbols.const_fields.applicable_kinds = field
dotnet_naming_symbols.const_fields.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.const_pascal.importance = 1

# Code quality / reliability
dotnet_diagnostic.IDE0005.severity = warning          # unnecessary usings
dotnet_diagnostic.CA2007.severity = none              # ConfigureAwait: ASP.NET Core has no sync context
dotnet_diagnostic.CA2016.severity = warning           # forward CancellationToken
dotnet_diagnostic.CA1849.severity = warning           # call async methods when in async method
dotnet_diagnostic.CA2012.severity = warning           # use ValueTasks correctly
dotnet_diagnostic.CA1062.severity = none              # nullable reference types cover this
dotnet_diagnostic.CA1848.severity = suggestion        # LoggerMessage delegates (perf only)
dotnet_diagnostic.CA1305.severity = warning           # specify IFormatProvider
dotnet_diagnostic.CA1307.severity = suggestion
dotnet_diagnostic.CA1309.severity = suggestion
dotnet_diagnostic.CA1310.severity = warning           # culture-sensitive string comparison

# Security analyzers (keep as errors via TreatWarningsAsErrors)
dotnet_diagnostic.CA2100.severity = warning           # SQL injection review
dotnet_diagnostic.CA2300.severity = warning           # insecure deserializers
dotnet_diagnostic.CA2326.severity = warning           # TypeNameHandling
dotnet_diagnostic.CA3001.severity = warning
dotnet_diagnostic.CA3003.severity = warning
dotnet_diagnostic.CA3075.severity = warning
dotnet_diagnostic.CA5350.severity = warning           # weak crypto
dotnet_diagnostic.CA5351.severity = warning           # broken crypto
dotnet_diagnostic.CA5394.severity = warning           # insecure randomness
dotnet_diagnostic.CA5397.severity = warning           # deprecated TLS

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none              # underscores in test names
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1849.severity = suggestion
dotnet_diagnostic.CA5394.severity = none              # tests may use non-crypto Random for data generation

[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0005.severity = none
